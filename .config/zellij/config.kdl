keybinds clear-defaults=true {
    normal {
        bind "Ctrl b" { SwitchToMode "Tmux"; }
        bind "Ctrl t" "Alt t" { SwitchToMode "RenameTab"; TabNameInput 0; }
        bind "Ctrl s" { SwitchToMode "EnterSearch"; SearchInput 0; }
    }

    tmux {
        // Essential tmux keybinds
        bind "Ctrl b" { Write 2; SwitchToMode "Normal"; }
        
        // Pane management
        bind "\"" { NewPane "Down"; SwitchToMode "Normal"; }
        bind "%" { NewPane "Right"; SwitchToMode "Normal"; }
        bind "x" { CloseFocus; SwitchToMode "Normal"; }
        bind "z" { ToggleFocusFullscreen; SwitchToMode "Normal"; }
        
        // Pane navigation  
        bind "h" { MoveFocus "Left"; SwitchToMode "Normal"; }
        bind "j" { MoveFocus "Down"; SwitchToMode "Normal"; }
        bind "k" { MoveFocus "Up"; SwitchToMode "Normal"; }
        bind "l" { MoveFocus "Right"; SwitchToMode "Normal"; }
        bind "Left" { MoveFocus "Left"; SwitchToMode "Normal"; }
        bind "Right" { MoveFocus "Right"; SwitchToMode "Normal"; }
        bind "Down" { MoveFocus "Down"; SwitchToMode "Normal"; }
        bind "Up" { MoveFocus "Up"; SwitchToMode "Normal"; }
        bind "o" { FocusNextPane; }
        
        // Tab/window management
        bind "c" { NewTab; SwitchToMode "Normal"; }
        bind "p" { GoToPreviousTab; SwitchToMode "Normal"; }
        bind "n" { GoToNextTab; SwitchToMode "Normal"; }
        bind "&" { CloseTab; SwitchToMode "Normal"; }
        bind "," "r" { SwitchToMode "RenameTab"; TabNameInput 0; }
        
        // Numbers for direct tab access
        bind "1" { GoToTab 1; SwitchToMode "Normal"; }
        bind "2" { GoToTab 2; SwitchToMode "Normal"; }
        bind "3" { GoToTab 3; SwitchToMode "Normal"; }
        bind "4" { GoToTab 4; SwitchToMode "Normal"; }
        bind "5" { GoToTab 5; SwitchToMode "Normal"; }
        bind "6" { GoToTab 6; SwitchToMode "Normal"; }
        bind "7" { GoToTab 7; SwitchToMode "Normal"; }
        bind "8" { GoToTab 8; SwitchToMode "Normal"; }
        bind "9" { GoToTab 9; SwitchToMode "Normal"; }
        
        // Copy mode
        bind "[" { SwitchToMode "Scroll"; }
        
        // Session management
        bind "d" { Detach; }
        bind "s" { SwitchToMode "Session"; }

        // Resize
        bind "Alt h" { Resize "Left"; }
        bind "Alt l" { Resize "Right"; }
        bind "Alt j" { Resize "Down"; }
        bind "Alt k" { Resize "Up"; }
        bind "Shift Left" { Resize "Left"; }
        bind "Shift Right" { Resize "Right"; }
        bind "Shift Down" { Resize "Down"; }
        bind "Shift Up" { Resize "Up"; }
    }

    scroll {
        bind "Esc" "q" { SwitchToMode "Normal"; }
        bind "j" "Down" { ScrollDown; }
        bind "k" "Up" { ScrollUp; }
        bind "Ctrl f" "PageDown" { PageScrollDown; }
        bind "Ctrl b" "PageUp" { PageScrollUp; }
        bind "d" { HalfPageScrollDown; }
        bind "u" { HalfPageScrollUp; }
        bind "/" { SwitchToMode "EnterSearch"; SearchInput 0; }
        bind "y" { Copy; }
    }

    search {
        bind "Esc" { SwitchToMode "Scroll"; }
        bind "Enter" { SwitchToMode "Scroll"; }
        bind "n" { Search "down"; }
        bind "N" { Search "up"; }
    }

    entersearch {
        bind "Enter" { SwitchToMode "Search"; }
        bind "Esc" { SwitchToMode "Normal"; }
    }

    renametab {
        bind "Enter" { SwitchToMode "Normal"; }
        bind "Esc" { UndoRenameTab; SwitchToMode "Normal"; }
    }

    session {
        bind "Esc" { SwitchToMode "Normal"; }
        bind "d" { Detach; }
    }
}

themes {
    adaptive-terminal {
        text_unselected {
            base 7
            background 0
            emphasis_0 11
            emphasis_1 14
            emphasis_2 10
            emphasis_3 13
        }
        text_selected {
            base 15
            background 8
            emphasis_0 11
            emphasis_1 14
            emphasis_2 10
            emphasis_3 13
        }
        ribbon_unselected {
            base 7
            background 8
            emphasis_0 11
            emphasis_1 14
            emphasis_2 10
            emphasis_3 13
        }
        ribbon_selected {
            base 0
            background 6
            emphasis_0 11
            emphasis_1 15
            emphasis_2 10
            emphasis_3 13
        }
        table_title {
            base 14
            background 0
            emphasis_0 11
            emphasis_1 14
            emphasis_2 10
            emphasis_3 13
        }
        table_cell_unselected {
            base 7
            background 0
            emphasis_0 11
            emphasis_1 14
            emphasis_2 10
            emphasis_3 13
        }
        table_cell_selected {
            base 15
            background 8
            emphasis_0 11
            emphasis_1 14
            emphasis_2 10
            emphasis_3 13
        }
        list_unselected {
            base 7
            background 0
            emphasis_0 11
            emphasis_1 14
            emphasis_2 10
            emphasis_3 13
        }
        list_selected {
            base 15
            background 8
            emphasis_0 11
            emphasis_1 14
            emphasis_2 10
            emphasis_3 13
        }
        frame_selected {
            base 6
            background 0
            emphasis_0 14
            emphasis_1 11
            emphasis_2 13
            emphasis_3 8
        }
        frame_highlight {
            base 12
            background 0
            emphasis_0 14
            emphasis_1 11
            emphasis_2 13
            emphasis_3 9
        }
        exit_code_success {
            base 10
            background 0
            emphasis_0 14
            emphasis_1 8
            emphasis_2 13
            emphasis_3 12
        }
        exit_code_error {
            base 9
            background 0
            emphasis_0 11
            emphasis_1 8
            emphasis_2 13
            emphasis_3 12
        }
        multiplayer_user_colors {
            player_1 13
            player_2 12
            player_3 10
            player_4 11
            player_5 14
            player_6 9
            player_7 6
            player_8 5
            player_9 4
            player_10 3
        }
    }
}

// Basic settings
on_force_close "detach"
pane_frames false
default_layout "simple"
default_mode "normal"
default_shell "nu"
mouse_mode true
copy_on_select true
theme "adaptive-terminal"
show_startup_tips false
